# PitchVision — local / self-host compose settings (AD §13.1, §14).
#
#   cp infra/compose/.env.example infra/compose/.env && chmod 600 infra/compose/.env
#
# .env is gitignored. Every value below is a LOCAL DEV placeholder, not a secret —
# replace the passwords/keys on any machine reachable by other people.
# Avoid URL-reserved characters (@ : / ? # %) in passwords: they are embedded in URLs.

COMPOSE_PROJECT_NAME=pitchvision
# Image tag for pitchvision-api / -worker / -web (CI pushes git-sha tags to GHCR).
TAG=dev
PV_ENV=local

# Worker image base. CPU-only dev (Mac, no NVIDIA): python:3.12-slim.
# gpu-local box (RTX 4090): nvidia/cuda:12.4.1-runtime-ubuntu22.04  (CUDA + TensorRT)
PV_WORKER_BASE=python:3.12-slim
# Queue for GPU stages (shots/calibrate/infer). CPU-only dev: `cpu` (cpu-worker runs them, slowly).
# gpu-local box: `gpu` (the gpu-worker of the gpu-local profile consumes it).
PV_LOCAL_GPU_QUEUE=cpu
# ComputeBackend priority (AD §7.1): local only for now (runpod = W5).
PV_COMPUTE_BACKENDS=local

# --- Postgres 16 + TimescaleDB ---
POSTGRES_USER=pitchvision
POSTGRES_PASSWORD=pitchvision-local-only
POSTGRES_DB=pitchvision
# login for pv_app, the RLS-bound role the api uses (migrate grants LOGIN with this password)
PV_APP_DB_PASSWORD=pv-app-local-only
# login for pv_worker, the workers' role (pv_app grants + INSERT on positions; migration 0004)
PV_WORKER_DB_PASSWORD=pv-worker-local-only

# --- Object storage (S3 API; SeaweedFS locally, Cloudflare R2 in cloud) ---
PV_STORAGE_BUCKET=pitchvision-local
PV_STORAGE_ACCESS_KEY=pv-local
PV_STORAGE_SECRET_KEY=pv-local-secret-change-me
PV_STORAGE_REGION=us-east-1
# Address the BROWSER uses for presigned PUT/GET (containers use http://storage:8333).
PV_STORAGE_PUBLIC_ENDPOINT=http://localhost:8333
# Origins allowed to PUT multipart parts directly to the bucket (web image, Vite dev server).
# Browser origins allowed to PUT upload parts. Default: ${PV_WEB_URL} + the Vite dev server (5173).
# PV_STORAGE_CORS_ORIGINS=https://app.example.com

# --- identity-svc (docs/contracts/identity-api.md) ---
# Browser origin of the web app: email links, Google redirect, JWT issuer. Keep in sync with PV_WEB_PORT.
PV_WEB_URL=http://localhost:3000
# Database on the same Postgres server (migrate-identity creates it).
PV_IDENTITY_DB=pitchvision_identity
# RS256 signing key (PEM, "\n" escapes allowed). Empty = ephemeral key, local only: sessions end when
# identity restarts. Required when PV_ENV is staging/production:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
PV_JWT_PRIVATE_KEY_PEM=
# Secure refresh cookie. Chrome/Firefox accept it on http://localhost; set false only for Safari on plain http.
PV_COOKIE_SECURE=true
# smtp -> mailpit (UI http://localhost:8025) | console (link in `docker compose logs identity`) | resend
PV_EMAIL_BACKEND=smtp
PV_RESEND_API_KEY=
# Google sign-in; empty = button disabled (start returns 404).
# Authorized redirect URI: ${PV_WEB_URL}/api/v1/auth/oidc/google/callback
PV_GOOGLE_CLIENT_ID=
PV_GOOGLE_CLIENT_SECRET=

# --- Host ports (all bound to 127.0.0.1) ---
PV_API_PORT=8000
PV_IDENTITY_PORT=8001
PV_MAILPIT_UI_PORT=8025
PV_MAILPIT_SMTP_PORT=1025
PV_WEB_PORT=3000
PV_POSTGRES_PORT=5432
PV_REDIS_PORT=6379
PV_STORAGE_PORT=8333

# Host directory with exported model weights (training/*/export scripts write ~/.cache/pitchvision/models).
PV_MODEL_DIR=${HOME}/.cache/pitchvision/models
# Worker processes. cpu-worker also runs GPU stages when PV_LOCAL_GPU_QUEUE=cpu (each process ~1.5 GB).
PV_CPU_CONCURRENCY=2
PV_GPU_CONCURRENCY=1
