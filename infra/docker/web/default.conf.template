# pitchvision-web nginx site. ${PV_*} placeholders are filled by envsubst at container start.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # identity-svc owns these paths on the shared origin (docs/contracts/identity-api.md); everything
    # else under /api/ goes to the regional api below. Regex locations win over the /api/ prefix.
    location ~ ^/api/v1/(auth/|me$|me/|orgs$|orgs/|invites/) {
        resolver ${PV_DNS_RESOLVER} valid=10s ipv6=off;
        set $pv_identity http://${PV_IDENTITY_UPSTREAM};
        proxy_pass $pv_identity;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;  # overwrite: client-sent XFF must not reach rate limiting
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 64k;
    }

    location = /.well-known/jwks.json {
        resolver ${PV_DNS_RESOLVER} valid=10s ipv6=off;
        set $pv_identity http://${PV_IDENTITY_UPSTREAM};
        proxy_pass $pv_identity;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # API + WebSocket on the same origin (self-host/compose). Resolved per request so nginx
    # still starts when the api container is down. In the cloud the SPA is on the CDN and
    # talks to the regional API directly.
    location /api/ {
        resolver ${PV_DNS_RESOLVER} valid=10s ipv6=off;
        set $pv_api http://${PV_API_UPSTREAM};
        proxy_pass $pv_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;  # overwrite: client-sent XFF must not reach rate limiting
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
        proxy_read_timeout 1h;
        client_max_body_size 1m;  # video bytes go browser -> object storage, never via nginx
    }

    # Vite emits content-hashed files under /assets/.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /config.js {
        add_header Cache-Control "no-cache";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # SPA fallback: client-side routes resolve to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
