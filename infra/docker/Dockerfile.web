# syntax=docker/dockerfile:1.7
# pitchvision-web — static Vite build of apps/web served by unprivileged nginx with SPA
# fallback. Build context: repository root.
#
#   docker build -f infra/docker/Dockerfile.web -t pitchvision-web:dev .
#
# apps/web is a member of the root pnpm workspace (lockfile at the repo root).
# packages/schemas/jsonschema is copied in because the web codegen reads it.

ARG NODE_IMAGE=node:22-alpine
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.27-alpine

# ---------------------------------------------------------------- build
FROM ${NODE_IMAGE} AS build
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=true \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /src

COPY packages/schemas/jsonschema packages/schemas/jsonschema
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web/package.json apps/web/
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter @pitchvision/web --store-dir /pnpm/store

COPY apps/web apps/web
RUN pnpm -C apps/web build

# ---------------------------------------------------------------- runtime
FROM ${NGINX_IMAGE} AS runtime
# Rendered by the nginx entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
ENV PV_API_UPSTREAM=api:8000 \
    PV_IDENTITY_UPSTREAM=identity:8000 \
    PV_DNS_RESOLVER=127.0.0.11
COPY infra/docker/web/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /src/apps/web/dist /usr/share/nginx/html

EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/healthz"]
