# Staging environment (copy to infra/staging/.env on the staging host, chmod 600). Never commit the real file.
# Generate secrets with: openssl rand -hex 32
COMPOSE_PROJECT_NAME=pitchvision-staging
PV_ENV=staging
PV_REGION=eu

# --- images: deploy.sh sets TAG (full git sha from CI); the registry is GHCR
PV_IMAGE_REGISTRY=ghcr.io/dongphuongman/
TAG=main

# --- address. Without a domain: <public-ip-with-dashes>.sslip.io, e.g. 203-0-113-7.sslip.io
PV_SITE=203-0-113-7.sslip.io
PV_WEB_URL=https://203-0-113-7.sslip.io
PV_CORS_ORIGINS=https://203-0-113-7.sslip.io
PV_COOKIE_SECURE=true

# --- database
POSTGRES_USER=pitchvision
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pitchvision
PV_APP_DB_PASSWORD=change-me
PV_WORKER_DB_PASSWORD=change-me
PV_IDENTITY_DB=pitchvision_identity

# --- object storage. Default: SeaweedFS on the VM, public at https://s3.<site>.
PV_STORAGE_BUCKET=pv-stg-eu-data
PV_STORAGE_ACCESS_KEY=change-me
PV_STORAGE_SECRET_KEY=change-me
PV_STORAGE_REGION=us-east-1
PV_STORAGE_PUBLIC_ENDPOINT=https://s3.203-0-113-7.sslip.io
# R2 instead (infra/terraform/envs/staging, bucket pv-stg-eu-data; CORS comes from Terraform):
# PV_STORAGE_ENDPOINT=https://<account>.eu.r2.cloudflarestorage.com
# PV_STORAGE_PUBLIC_ENDPOINT=https://<account>.eu.r2.cloudflarestorage.com
# PV_STORAGE_REGION=auto

# --- secrets shared by services
PV_TILE_SIGNING_KEY=change-me-at-least-32-characters
PV_INTERNAL_TOKEN=change-me

# --- identity: the signing key is generated once into the identity-keys volume (keep the volume)
PV_JWT_PRIVATE_KEY_PEM=
PV_EMAIL_BACKEND=smtp
PV_EMAIL_FROM=PitchVision Staging <no-reply@pitchvision.local>
# Mailpit UI at https://mail.<site>, basic auth. Hash: see README (every $ doubled as $$)
PV_MAILPIT_USER=staging
# example hash of "change-me" — replace it
PV_MAILPIT_HASH=$$2a$$14$$RXY/eQfD4bFEZa/Nyu0xiORA3Ql4WAODG67ebk6ls6cNeiuQb8bwa
PV_GOOGLE_CLIENT_ID=
PV_GOOGLE_CLIENT_SECRET=

# --- pipeline on a CPU-only VM (GPU stages run slowly on the cpu queue)
PV_LOCAL_GPU_QUEUE=cpu
PV_COMPUTE_BACKENDS=local
PV_CPU_CONCURRENCY=2
PV_INGEST_CONCURRENCY=2
PV_MODEL_DIR=/opt/pitchvision/models

# --- observability (M1-OPS-08)
PV_SENTRY_DSN=
PV_WEB_SENTRY_DSN=
PV_METRICS_TOKEN=change-me
# Slack incoming webhook, or a Discord webhook URL + /slack
PV_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE/ME
