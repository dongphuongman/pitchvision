              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "h_quality; null = no homography",
          "title": "Hq"
        },
        "objs": {
          "items": {
            "maxItems": 10,
            "minItems": 10,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            ],
            "type": "array"
          },
          "title": "Objs",
          "type": "array"
        }
      },
      "required": [
        "f"
      ],
      "title": "TileFrame",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "fps": {
      "title": "Fps",
      "type": "integer"
    },
    "frames": {
      "items": {
        "$ref": "#/$defs/TileFrame"
      },
      "title": "Frames",
      "type": "array"
    },
    "shots": {
      "description": "[f0, f1_exclusive, type] runs covering this tile",
      "items": {
        "maxItems": 3,
        "minItems": 3,
        "prefixItems": [
          {
            "type": "integer"
          },
          {
            "type": "integer"
          },
