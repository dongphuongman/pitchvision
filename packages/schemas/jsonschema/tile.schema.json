            "$ref": "#/$defs/ShotType"
          }
        ],
        "type": "array"
      },
      "title": "Shots",
      "type": "array"
    },
    "t0_ms": {
      "title": "T0 Ms",
      "type": "integer"
    },
    "t1_ms": {
      "title": "T1 Ms",
      "type": "integer"
    },
    "tile_no": {
      "minimum": 0,
      "title": "Tile No",
      "type": "integer"
    },
    "v": {
      "default": 1,
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "tile_no",
    "t0_ms",
    "t1_ms",
    "fps",
    "frames"
  ],
  "title": "Tile",
  "type": "object"
