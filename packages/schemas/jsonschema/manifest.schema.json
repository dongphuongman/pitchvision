{
  "$defs": {
    "Coverage": {
      "properties": {
        "homography_ok_pct": {
          "description": "% of main_wide frames with h_quality \u2265 0.5",
          "maximum": 100,
          "minimum": 0,
          "title": "Homography Ok Pct",
          "type": "number"
        },
        "main_wide_pct": {
          "description": "% of duration with analysable wide shots",
          "maximum": 100,
          "minimum": 0,
          "title": "Main Wide Pct",
          "type": "number"
        }
      },
      "required": [
        "main_wide_pct",
        "homography_ok_pct"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "PitchCalibration": {
      "properties": {
        "length_m": {
          "default": 105.0,
          "title": "Length M",
          "type": "number"
        },
        "status": {
          "description": "ok \u00b7 degraded (> 30 % of main_wide frames below h_quality 0.5) \u00b7 manual (user calibrated) \u00b7 unavailable (no pitch keypoint model: px/py are null, no tactical map)",
          "enum": [
            "ok",
            "degraded",
            "manual",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "width_m": {
          "default": 68.0,
          "title": "Width M",
          "type": "number"
        }
      },
      "required": [
        "status"
      ],
      "title": "PitchCalibration",
      "type": "object"
    },
    "Shot": {
      "properties": {
        "conf": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Conf",
          "type": "number"
        },
        "t0_ms": {
          "minimum": 0,
          "title": "T0 Ms",
          "type": "integer"
        },
        "t1_ms": {
          "exclusiveMinimum": 0,
          "title": "T1 Ms",
          "type": "integer"
        },
        "type": {
          "$ref": "#/$defs/ShotType"
        }
      },
      "required": [
        "t0_ms",
        "t1_ms",
        "type",
        "conf"
      ],
      "title": "Shot",
      "type": "object"
    },
    "ShotType": {
      "enum": [
        "main_wide",
        "close_up",
        "replay",
        "other"
      ],
      "title": "ShotType",
      "type": "string"
    },
    "TeamInfo": {
      "properties": {
        "attack_h1": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Side this team attacks in the first half as the main camera sees it (SCR-14 E05); null = unknown",
          "title": "Attack H1"
        },
        "cluster": {
          "title": "Cluster",
          "type": "integer"
        },
        "color": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "confirmed": {
          "default": false,
          "title": "Confirmed",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "cluster",
        "name",
        "color"
      ],
      "title": "TeamInfo",
      "type": "object"
    },
    "TrackOverride": {
      "description": "A user's fix of one track (SCR-14 E06): tiles keep the detected team / class, players apply this on top.",
      "properties": {
        "cls": {
          "description": "ObjCls: 0 player, 1 goalkeeper, 2 referee",
          "maximum": 2,
          "minimum": 0,
          "title": "Cls",
          "type": "integer"
        },
        "team": {
          "description": "cluster 0 / 1, -1 = no team (referee)",
          "maximum": 1,
          "minimum": -1,
          "title": "Team",
          "type": "integer"
        },
        "track_id": {
          "title": "Track Id",
          "type": "integer"
        }
      },
      "required": [
        "track_id",
        "team",
        "cls"
      ],
      "title": "TrackOverride",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "duration_ms": {
      "title": "Duration Ms",
      "type": "integer"
    },
    "fps": {
      "title": "Fps",
      "type": "integer"
    },
    "frame_count": {
      "title": "Frame Count",
      "type": "integer"
    },
    "height": {
      "title": "Height",
      "type": "integer"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "pitch": {
      "$ref": "#/$defs/PitchCalibration"
    },
    "revision": {
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "shots": {
      "items": {
        "$ref": "#/$defs/Shot"
      },
      "title": "Shots",
      "type": "array"
    },
    "teams": {
      "items": {
        "$ref": "#/$defs/TeamInfo"
      },
      "title": "Teams",
      "type": "array"
    },
    "tile_count": {
      "title": "Tile Count",
      "type": "integer"
    },
    "tile_ms": {
      "default": 10000,
      "title": "Tile Ms",
      "type": "integer"
    },
    "tile_url_template": {
      "description": "e.g. /api/v1/tiles/{video}/{job}/r0/{tile_no}.json.gz?exp=\u2026&sig=\u2026 \u2014 {tile_no} is 6-digit. Signed, expires (re-fetch the manifest on 403). The stored manifest.json holds the object-key template.",
      "title": "Tile Url Template",
      "type": "string"
    },
    "track_overrides": {
      "description": "Confirmed team / role fixes per track (served from the players table)",
      "items": {
        "$ref": "#/$defs/TrackOverride"
      },
      "title": "Track Overrides",
      "type": "array"
    },
    "video_id": {
      "title": "Video Id",
      "type": "string"
    },
    "width": {
      "title": "Width",
      "type": "integer"
    }
  },
  "required": [
    "video_id",
    "job_id",
    "revision",
    "fps",
    "width",
    "height",
    "duration_ms",
    "frame_count",
    "tile_count",
    "tile_url_template",
    "shots",
    "coverage",
    "teams",
    "pitch"
  ],
  "title": "Manifest",
  "type": "object"
}
