{
  "$defs": {
    "CancelledData": {
      "properties": {
        "video_id": {
          "title": "Video Id",
          "type": "string"
        }
      },
      "required": [
        "video_id"
      ],
      "title": "CancelledData",
      "type": "object"
    },
    "CancelledEvent": {
      "description": "The job was cancelled (POST /jobs/{id}/cancel or the video was deleted); no further events follow.",
      "properties": {
        "data": {
          "$ref": "#/$defs/CancelledData"
        },
        "topic": {
          "title": "Topic",
          "type": "string"
        },
        "type": {
          "const": "cancelled",
          "default": "cancelled",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "type",
        "data"
      ],
      "title": "CancelledEvent",
      "type": "object"
    },
    "CompletedData": {
      "properties": {
        "video_id": {
          "title": "Video Id",
          "type": "string"
        }
      },
      "required": [
        "video_id"
      ],
      "title": "CompletedData",
      "type": "object"
    },
    "CompletedEvent": {
      "properties": {
        "data": {
          "$ref": "#/$defs/CompletedData"
        },
        "topic": {
          "title": "Topic",
          "type": "string"
        },
        "type": {
          "const": "completed",
          "default": "completed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "type",
        "data"
      ],
      "title": "CompletedEvent",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "VALIDATION_FAILED",
        "NOT_FOUND",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "METHOD_NOT_ALLOWED",
        "CONFLICT",
        "IDEMPOTENCY_KEY_REQUIRED",
        "IDEMPOTENCY_KEY_REUSED",
        "QUOTA_EXCEEDED",
        "PLAN_REQUIRED",
        "RATE_LIMITED",
        "INTERNAL",
        "EMAIL_TAKEN",
        "INVALID_CREDENTIALS",
        "EMAIL_NOT_VERIFIED",
        "TOKEN_EXPIRED",
        "LAST_OWNER",
        "INVITE_EMAIL_MISMATCH",
        "REGION_MISMATCH",
        "VIDEO_UNREADABLE",
        "NO_WIDE_SHOTS",
        "TEAM_SEPARATION_FAILED",
        "HOMOGRAPHY_UNAVAILABLE",
        "INGEST_FAILED",
        "EXPORT_FAILED"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorData": {
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode",
          "description": "VALIDATION_FAILED \u00b7 NOT_FOUND (unknown job or another org's) \u00b7 RATE_LIMITED"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "code"
      ],
      "title": "ErrorData",
      "type": "object"
    },
    "ErrorMessage": {
      "properties": {
        "data": {
          "$ref": "#/$defs/ErrorData"
        },
        "topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the topic the failed op referred to, if any",
          "title": "Topic"
        },
        "type": {
          "const": "error",
          "default": "error",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "topic",
        "data"
      ],
      "title": "ErrorMessage",
      "type": "object"
    },
    "FailedData": {
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "retryable"
      ],
      "title": "FailedData",
      "type": "object"
    },
    "FailedEvent": {
      "properties": {
        "data": {
          "$ref": "#/$defs/FailedData"
        },
        "topic": {
          "title": "Topic",
          "type": "string"
        },
        "type": {
          "const": "failed",
          "default": "failed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "type",
        "data"
      ],
      "title": "FailedEvent",
      "type": "object"
    },
    "JobStatus": {
      "enum": [
        "queued",
        "ingesting",
        "calibrating",
        "inferring",
        "postprocessing",
        "done",
        "failed",
        "cancelled"
      ],
      "title": "JobStatus",
      "type": "string"
    },
    "PingMessage": {
      "description": "Server heartbeat every HEARTBEAT_S seconds.",
      "properties": {
        "ts": {
          "description": "server time, Unix seconds",
          "title": "Ts",
          "type": "integer"
        },
        "type": {
          "const": "ping",
          "default": "ping",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "ts"
      ],
      "title": "PingMessage",
      "type": "object"
    },
    "PongMessage": {
      "properties": {
        "type": {
          "const": "pong",
          "default": "pong",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "PongMessage",
      "type": "object"
    },
    "ProgressData": {
      "properties": {
        "eta_s": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eta S"
        },
        "fps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fps"
        },
        "pct": {
          "maximum": 100,
          "minimum": 0,
          "title": "Pct",
          "type": "number"
        },
        "segments": {
          "anyOf": [
            {
              "$ref": "#/$defs/SegmentCounts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "pct"
      ],
      "title": "ProgressData",
      "type": "object"
    },
    "ProgressEvent": {
      "properties": {
        "data": {
          "$ref": "#/$defs/ProgressData"
        },
        "topic": {
          "title": "Topic",
          "type": "string"
        },
        "type": {
          "const": "progress",
          "default": "progress",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "type",
        "data"
      ],
      "title": "ProgressEvent",
      "type": "object"
    },
    "SegmentCounts": {
      "properties": {
        "done": {
          "title": "Done",
          "type": "integer"
        },
        "running": {
          "title": "Running",
          "type": "integer"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "done",
        "running",
        "total"
      ],
      "title": "SegmentCounts",
      "type": "object"
    },
    "SubscribedData": {
      "properties": {
        "status": {
          "$ref": "#/$defs/JobStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "SubscribedData",
      "type": "object"
    },
    "SubscribedMessage": {
      "properties": {
        "data": {
          "$ref": "#/$defs/SubscribedData"
        },
        "topic": {
          "title": "Topic",
          "type": "string"
        },
        "type": {
          "const": "subscribed",
          "default": "subscribed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "type",
        "data"
      ],
      "title": "SubscribedMessage",
      "type": "object"
    },
    "UnsubscribedMessage": {
      "properties": {
        "topic": {
          "title": "Topic",
          "type": "string"
        },
        "type": {
          "const": "unsubscribed",
          "default": "unsubscribed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "type"
      ],
      "title": "UnsubscribedMessage",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "cancelled": "#/$defs/CancelledEvent",
      "completed": "#/$defs/CompletedEvent",
      "error": "#/$defs/ErrorMessage",
      "failed": "#/$defs/FailedEvent",
      "ping": "#/$defs/PingMessage",
      "pong": "#/$defs/PongMessage",
      "progress": "#/$defs/ProgressEvent",
      "subscribed": "#/$defs/SubscribedMessage",
      "unsubscribed": "#/$defs/UnsubscribedMessage"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ProgressEvent"
    },
    {
      "$ref": "#/$defs/CompletedEvent"
    },
    {
      "$ref": "#/$defs/FailedEvent"
    },
    {
      "$ref": "#/$defs/CancelledEvent"
    },
    {
      "$ref": "#/$defs/SubscribedMessage"
    },
    {
      "$ref": "#/$defs/UnsubscribedMessage"
    },
    {
      "$ref": "#/$defs/PingMessage"
    },
    {
      "$ref": "#/$defs/PongMessage"
    },
    {
      "$ref": "#/$defs/ErrorMessage"
    }
  ]
}
