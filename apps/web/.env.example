# Base URL of the PitchVision API (no trailing slash). Same-origin when unset.
VITE_API_URL=http://localhost:8000
# Base URL of the global identity service (no trailing slash). Same-origin when unset.
# The pv_refresh cookie is scoped to this origin, so keep it same-site with the web app.
VITE_IDENTITY_URL=
# Dev only: serve identity endpoints from in-browser MSW mocks (src/mocks) — `VITE_MOCK_API=1 pnpm dev`.
VITE_MOCK_API=
