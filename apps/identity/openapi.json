    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register",
        "description": "Create an account. With a matching `invite_token` the email counts as verified and the membership is\ncreated; otherwise a verification email is sent.",
