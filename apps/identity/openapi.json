        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/me/unverified": {
      "delete": {
        "tags": [
          "me"
        ],
        "summary": "Delete Unverified",
        "description": "Deletes the account if its email is not verified yet (409 CONFLICT otherwise) and clears the cookie.",
        "operationId": "delete_unverified_api_v1_me_unverified_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "4XX": {
            "description": "Client Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "5XX": {
            "description": "Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_FAILED",
          "NOT_FOUND",
          "UNAUTHENTICATED",
          "FORBIDDEN",
          "METHOD_NOT_ALLOWED",
          "CONFLICT",
          "IDEMPOTENCY_KEY_REQUIRED",
          "IDEMPOTENCY_KEY_REUSED",
          "QUOTA_EXCEEDED",
          "RATE_LIMITED",
          "INTERNAL",
          "EMAIL_TAKEN",
          "INVALID_CREDENTIALS",
          "EMAIL_NOT_VERIFIED",
          "TOKEN_EXPIRED",
          "LAST_OWNER",
          "INVITE_EMAIL_MISMATCH",
          "REGION_MISMATCH",
          "VIDEO_UNREADABLE",
          "NO_WIDE_SHOTS",
          "TEAM_SEPARATION_FAILED",
          "HOMOGRAPHY_UNAVAILABLE",
          "INGEST_FAILED"
        ],
        "title": "ErrorCode"
      },
      "FieldError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "msg": {
            "type": "string",
            "title": "Msg"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "FieldError"
      },
      "ForgotIn": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email"
        ],
        "title": "ForgotIn"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthStatus"
      },
      "Jwk": {
        "properties": {
          "kty": {
            "type": "string",
            "title": "Kty"
          },
          "kid": {
            "type": "string",
            "title": "Kid"
          },
          "use": {
            "type": "string",
            "title": "Use"
          },
          "alg": {
            "type": "string",
            "title": "Alg"
          },
          "n": {
            "type": "string",
            "title": "N"
          },
          "e": {
            "type": "string",
            "title": "E"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "kty",
          "kid",
          "use",
          "alg",
          "n",
          "e"
        ],
        "title": "Jwk"
      },
      "Jwks": {
        "properties": {
          "keys": {
            "items": {
              "$ref": "#/components/schemas/Jwk"
            },
            "type": "array",
            "title": "Keys"
          }
        },
        "type": "object",
        "required": [
          "keys"
        ],
        "title": "Jwks"
      },
      "LoginIn": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginIn"
      },
      "Me": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "email_verified": {
            "type": "boolean",
            "title": "Email Verified"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "memberships": {
            "items": {
              "$ref": "#/components/schemas/Membership"
            },
            "type": "array",
            "title": "Memberships"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "email_verified",
          "created_at",
          "memberships"
        ],
        "title": "Me"
      },
      "Membership": {
        "properties": {
          "org_id": {
            "type": "string",
            "format": "uuid",
            "title": "Org Id"
          },
          "org_name": {
            "type": "string",
            "title": "Org Name"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "editor",
              "viewer"
            ],
            "title": "Role"
          },
          "region": {
            "type": "string",
            "enum": [
              "eu",
              "us"
            ],
            "title": "Region"
          }
        },
        "type": "object",
        "required": [
          "org_id",
          "org_name",
          "role",
          "region"
        ],
        "title": "Membership"
      },
      "ProblemDetails": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "ProblemDetails",
        "description": "OpenAPI shape of every 4xx/5xx body: Problem + optional `errors` extension (422 only)."
      },
      "RefreshIn": {
        "properties": {
          "org_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Org Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "RefreshIn"
      },
      "RegisterIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 10,
            "title": "Password"
          },
          "plan": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "title": "RegisterIn"
      },
      "ResetIn": {
        "properties": {
