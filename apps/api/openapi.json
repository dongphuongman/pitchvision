{
  "openapi": "3.1.0",
  "info": {
    "title": "PitchVision API",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readyz",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meta": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Meta",
        "operationId": "meta_api_v1_meta_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Meta"
                }
              }
            }
          },
          "4XX": {
            "description": "Client Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "5XX": {
            "description": "Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/videos": {
      "get": {
        "tags": [
          "videos"
        ],
        "summary": "List Videos",
        "operationId": "list_videos_api_v1_videos_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoPage"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Client Error"
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Server Error"
          }
        }
      }
    },
    "/api/v1/videos/{video_id}": {
      "get": {
        "tags": [
          "videos"
        ],
        "summary": "Get Video",
        "operationId": "get_video_api_v1_videos__video_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "video_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Video Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoOut"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Client Error"
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Server Error"
          }
        }
      }
    },
    "/api/v1/videos/uploads": {
      "post": {
        "tags": [
          "videos"
        ],
        "summary": "Create Upload",
        "description": "Create the video + multipart upload; returns presigned PUT URLs for the first parts.\n\nPUT each 16 MiB slice (the last may be shorter) to its URL, keep the `ETag` response header,\nthen POST /videos/{id}/uploads/complete. Do not change the part size when resuming.",
        "operationId": "create_upload_api_v1_videos_uploads_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadCreated"
                }
              }
            }
          },
          "4XX": {
            "description": "Client Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "5XX": {
            "description": "Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/videos/{video_id}/uploads/sign": {
      "post": {
        "tags": [
          "videos"
        ],
        "summary": "Sign Parts",
        "description": "Presign more part URLs (≤ 100 per call), e.g. for the next batch or when resuming.",
        "operationId": "sign_parts_api_v1_videos__video_id__uploads_sign_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "video_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Video Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignParts"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedParts"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Client Error"
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Server Error"
          }
        }
      }
    },
    "/api/v1/videos/{video_id}/uploads": {
      "get": {
        "tags": [
          "videos"
        ],
        "summary": "Get Upload",
        "description": "Parts already stored (ListParts) — resume uploads only the missing ones.",
        "operationId": "get_upload_api_v1_videos__video_id__uploads_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "video_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Video Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadState"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Client Error"
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Server Error"
          }
        }
      },
      "delete": {
        "tags": [
          "videos"
        ],
        "summary": "Abort Upload",
        "description": "Abort the multipart upload and mark the video deleted.",
        "operationId": "abort_upload_api_v1_videos__video_id__uploads_delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "video_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Video Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Client Error"
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Server Error"
          }
        }
      }
    },
    "/api/v1/videos/{video_id}/uploads/complete": {
      "post": {
        "tags": [
          "videos"
        ],
        "summary": "Complete Upload",
        "description": "Verify every part (count, 16 MiB sizes, ETags), complete the upload, check the object size → `ready`.",
        "operationId": "complete_upload_api_v1_videos__video_id__uploads_complete_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "video_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Video Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadComplete"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoOut"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Client Error"
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Server Error"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CompletedPart": {
        "properties": {
          "part_number": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Part Number"
          },
          "etag": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Etag"
          }
        },
        "type": "object",
        "required": [
          "part_number",
          "etag"
        ],
        "title": "CompletedPart"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_FAILED",
          "NOT_FOUND",
          "UNAUTHENTICATED",
          "FORBIDDEN",
          "METHOD_NOT_ALLOWED",
          "CONFLICT",
          "IDEMPOTENCY_KEY_REQUIRED",
          "IDEMPOTENCY_KEY_REUSED",
          "QUOTA_EXCEEDED",
          "RATE_LIMITED",
          "INTERNAL",
          "EMAIL_TAKEN",
          "INVALID_CREDENTIALS",
          "EMAIL_NOT_VERIFIED",
          "TOKEN_EXPIRED",
          "LAST_OWNER",
          "INVITE_EMAIL_MISMATCH",
          "REGION_MISMATCH",
          "VIDEO_UNREADABLE",
          "NO_WIDE_SHOTS",
          "TEAM_SEPARATION_FAILED",
          "HOMOGRAPHY_UNAVAILABLE",
          "INGEST_FAILED"
        ],
        "title": "ErrorCode"
      },
      "FieldError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "msg": {
            "type": "string",
            "title": "Msg"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "FieldError"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthStatus"
      },
      "Meta": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          },
          "schema_version": {
            "type": "integer",
            "title": "Schema Version"
          }
        },
        "type": "object",
        "required": [
          "version",
          "schema_version"
        ],
        "title": "Meta"
      },
      "PartUrl": {
        "properties": {
          "part_number": {
            "type": "integer",
            "title": "Part Number"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "part_number",
          "url"
        ],
        "title": "PartUrl"
      },
      "ProblemDetails": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "ProblemDetails",
        "description": "OpenAPI shape of every 4xx/5xx body: Problem + optional `errors` extension (422 only)."
      },
      "SignParts": {
        "properties": {
          "part_numbers": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Part Numbers"
          }
        },
        "type": "object",
        "required": [
          "part_numbers"
        ],
        "title": "SignParts"
      },
      "SignedParts": {
        "properties": {
          "parts": {
            "items": {
              "$ref": "#/components/schemas/PartUrl"
            },
            "type": "array",
            "title": "Parts"
          },
          "url_expires_in": {
            "type": "integer",
            "title": "Url Expires In"
          }
        },
        "type": "object",
        "required": [
          "parts",
          "url_expires_in"
        ],
        "title": "SignedParts"
      },
      "StoredPartOut": {
        "properties": {
          "part_number": {
            "type": "integer",
            "title": "Part Number"
          },
          "etag": {
            "type": "string",
            "title": "Etag"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          }
        },
        "type": "object",
        "required": [
          "part_number",
          "etag",
          "size"
        ],
        "title": "StoredPartOut"
      },
      "UploadComplete": {
        "properties": {
          "parts": {
            "items": {
              "$ref": "#/components/schemas/CompletedPart"
            },
            "type": "array",
            "maxItems": 10000,
            "minItems": 1,
            "title": "Parts"
          }
        },
        "type": "object",
        "required": [
          "parts"
        ],
        "title": "UploadComplete"
      },
      "UploadCreate": {
        "properties": {
          "filename": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Filename"
          },
          "size": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Size",
            "description": "File size in bytes"
          },
          "mime": {
            "type": "string",
            "maxLength": 127,
            "title": "Mime",
            "description": "Browser-reported type; may be empty",
            "default": ""
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "filename",
          "size"
        ],
        "title": "UploadCreate"
      },
      "UploadCreated": {
        "properties": {
          "video_id": {
            "type": "string",
            "format": "uuid",
            "title": "Video Id"
          },
          "upload_id": {
            "type": "string",
            "title": "Upload Id"
          },
          "part_size": {
            "type": "integer",
            "title": "Part Size",
            "description": "Fixed 16 MiB; every part but the last must be exactly this size"
          },
          "part_count": {
            "type": "integer",
            "title": "Part Count"
          },
          "parts": {
            "items": {
              "$ref": "#/components/schemas/PartUrl"
            },
            "type": "array",
            "title": "Parts",
            "description": "Presigned PUT URLs for the first batch; sign more via /uploads/sign"
          },
          "url_expires_in": {
            "type": "integer",
            "title": "Url Expires In",
            "description": "Seconds until the presigned URLs expire"
          },
          "video": {
            "$ref": "#/components/schemas/VideoOut"
          }
        },
        "type": "object",
        "required": [
          "video_id",
          "upload_id",
          "part_size",
          "part_count",
          "parts",
          "url_expires_in",
          "video"
        ],
        "title": "UploadCreated"
      },
      "UploadState": {
        "properties": {
          "video_id": {
            "type": "string",
            "format": "uuid",
            "title": "Video Id"
          },
          "upload_id": {
            "type": "string",
            "title": "Upload Id"
          },
          "part_size": {
            "type": "integer",
            "title": "Part Size"
          },
          "part_count": {
            "type": "integer",
            "title": "Part Count"
          },
          "parts": {
            "items": {
              "$ref": "#/components/schemas/StoredPartOut"
            },
            "type": "array",
            "title": "Parts",
            "description": "Parts already stored (resume: upload only the others)"
          }
        },
        "type": "object",
        "required": [
          "video_id",
          "upload_id",
          "part_size",
          "part_count",
          "parts"
        ],
        "title": "UploadState"
      },
      "VideoError": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "VideoError"
      },
      "VideoOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "status": {
            "type": "string",
            "enum": [
              "uploading",
              "ingesting",
              "ready",
              "processing",
              "done",
              "failed",
              "deleted"
            ],
            "title": "Status"
          },
          "source_type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "upload",
                  "youtube",
                  "rtsp",
                  "import"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Type"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url",
            "description": "Original URL for YouTube sources"
          },
          "size_bytes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Size Bytes"
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms"
          },
          "fps": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fps"
          },
